//추가실습2) 하이퍼터미널에 문자열을 출력하시오.

#include <avr/io.h>
 #include <util/delay.h>
 
 unsigned char Tmp[16]={'K','N','U','_','c','j',' ','J','e','o','n','g','_','P','E','L'};
int cnt =0;
 int main(void)
 {
 UCSR1A=0x00;  
 UCSR1B=0x08;               // TXEN set: 송신기 enable, PD0=RxD
 UCSR1C=0x06;               // Asynchronous operation, no parity, stop_bit 1,
                                    //  UCSZ1~0:11 전송문자 8 bit
 UBRR1H=0x00;  
 UBRR1L=0x33;               //  UBRR=51 ? 12bit baud rate(19.2k at 16MHz)
 
 while(1)
{  
           
	 for(cnt=0;cnt<16;cnt++)
	 {
	 while((UCSR1A&0x20)==0x00);    // 송신버퍼 UDR에 쓸 수 있는지 확인
            _delay_ms(2000);  
           
     _delay_ms(100);
     
            UDR1=Tmp[cnt];}                     //  문자 배열 출력
	if(cnt==16){break;}
      }
 }

