//추가실습1) 수신 완료 인터럽트(Receive Complete interrupt)를 사용하여 키보드로 수신 받은 값을 하이퍼터미널로 송신하시오. (UCSR1B=0x98)

#include <avr/io.h>
 #include <util/delay.h>
 unsigned char temp;
 int main(void)
 {
 UCSR1A=0x00;
       UCSR1B=0x98;                           // RXEN,TXEN set: 송수신기 enable
   UCSR1C=0x06;  
  UBRR1L=0x33;                           // Baud Rate: 19.2k
 while(1)
 {
 if((UCSR1A&0x80)==0x80) {     // 수신 데이터 여부 check  
 temp=UDR1;                      // 수신 데이터를 임시변수에 저장  
     while((UCSR1A&0x20)==0x00);     // 송신 가능 check
 
 UDR1=temp;                      // 수신 문자를 송신
       
 }}
 }

