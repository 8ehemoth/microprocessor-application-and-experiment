//추가실습3) AD 변환 값을 하이퍼터미널에 출력하시오.

#include <avr/io.h>
#include <util/delay.h>

unsigned char temp[3]={'0','.','0'}; // 변환값 표시를 위한 상수값 선언 및 초기화
int Result;
int i=0;

int main(void)
{

PORTA=0x00;

TCCR0=0x6f;


//--- ADC 초기 설정 ------------------------------------------
ADMUX=0x00;     // 기준전압 → AREF(외부전압), 우측 정렬 저장,
           // Single ended input ADC0 채널 선택
ADCSRA=0b10010111;    // ADC enable, Division Factor=128  
 
while(1)
{
ADCSRA |=0x40;               // AD 변환 시작: ADSC=1
while((ADCSRA&0x10)==0x00);  // AD 변환 완료까지 기다림. ADIF=1 check
Result = ADC;                 // Result라는 변수에 ADC 변환 값 저장
_delay_ms(1);               // 변환 시간 확보
Result=(Result>>2)*50/255;      // X.X로 표시하기위해 변환 결과를
                                              //  0~50으로 Scale            
temp[0]=Result/10 + '0';         // 앞자리 LCD 출력 값 추출
temp[2]=Result%10 + '0';        // 소숫점 뒷자리 LCD 출력 값 추출  

for(i=0; i<3; i++)
{

               _delay_ms(100);

 UCSR1A=0x00;
       UCSR1B=0x18;                           // RXEN,TXEN set: 송수신기 enable
   UCSR1C=0x06;  
  UBRR1L=0x33;                           // Baud Rate: 19.2k

 

 UDR1=temp[i];                      // 수신 문자를 송신


 
 }
 if(i==3){
 UDR1=0x0a;
 _delay_ms(100);
 UDR1=0x0d;
 _delay_ms(100);
 i=0;}


}
_delay_ms(1);



}

