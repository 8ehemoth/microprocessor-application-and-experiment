#define F_CPU 16000000L
#include <avr/io.h>
#include <util/delay.h>
#include <avr/interrupt.h>

int a = 0;
int erase = 0;

void lcd_inst(unsigned char value) // 명령어 입력
{
PORTA &= ~0x02; // RS=0 → PA1=0
_delay_ms(1);
PORTA |= 0x08; // E=1(& RS=0) → PA3=1
_delay_ms(1);
PORTC=value; // Instruction 값을 PORTC로 출력
_delay_ms(1);
PORTA &= 0x00; // E=0 & RS=0로 clear
_delay_ms(1);
}

void lcd_init() // LCD 초기화
{
_delay_ms(50);
lcd_inst(0x38);
_delay_ms(1);
lcd_inst(0b00001100);
_delay_ms(1);
lcd_inst(0x01);
_delay_ms(1);
lcd_inst(0b00000110);
_delay_ms(1);
}

void lcd_ch(unsigned char ch)
{
PORTA |= 0x02;
_delay_ms(1);
PORTA |= 0x08;
_delay_ms(1);
PORTC=ch;
_delay_ms(1);
PORTA &= 0x00;
_delay_ms(1);
}

void lcdout(unsigned char add, unsigned char cc)
{
lcd_inst(add | 0x80);
_delay_ms(1);
lcd_ch(cc);
}

void lcd_print(char line, char *text)
{
lcd_inst(line | 0x80);
while(*text)

lcd_ch(*text++);
}

ISR(INT0_vect)
{
if(a>-5){
a = a - 1;
erase = 1;
}
}

ISR(INT1_vect)
{
if(a<6){
a = a + 1;
erase = 1;
}
}

int main(void)
{
DDRC=0xff;
DDRA=0x0A;
lcd_init();
_delay_ms(20);

SREG |= 0x80;
EIMSK=0x03;
EICRA=0x0F;

while(1){
if(erase==1){
erase = 0;
lcd_inst(0x01);       //DB0에 1을 넣어서 LCD 표시 클리어, 커서 홈위치
_delay_ms(100);
}

lcd_print(0x45 + a, "POWER");
}

}
