#include<avr/io.h>
#include<avr/interrupt.h>
#include<util/delay.h>

void lcd_inst(unsigned char value) // 명령어 입력
{
	PORTA &= ~0x02; // RS=0 → PA1=0
	_delay_ms(1);
	PORTA |= 0x08; // E=1(& RS=0) → PA3=1
	_delay_ms(1);
	PORTC=value; // Instruction 값을 PORTC로 출력
	_delay_ms(1);
	PORTA &= 0x00; // E=0 & RS=0로 clear
	_delay_ms(1);
}

void lcd_init() // LCD 초기화
{
	_delay_ms(50);
	lcd_inst(0x38);
	_delay_ms(1);
	lcd_inst(0b00001100);
	_delay_ms(1);
	lcd_inst(0x01);
	_delay_ms(1);
	lcd_inst(0b00000110);
	_delay_ms(1);
}

void lcd_ch(unsigned char ch)
{
	PORTA |= 0x02;
	_delay_ms(1);
	PORTA |= 0x08;
	_delay_ms(1);
	PORTC=ch;
	_delay_ms(1);
	PORTA &= 0x00;
	_delay_ms(1);
}

void lcdout(unsigned char add, unsigned char cc)
{
	lcd_inst(add | 0x80);
	_delay_ms(1);
	lcd_ch(cc);
}

void lcd_print(char line, char *text)
{
	lcd_inst(line | 0x80);
	while(*text)

	lcd_ch(*text++);
}

